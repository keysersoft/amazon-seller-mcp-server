# Copied to .env by scripts/install.sh, which also fills the secrets.
# Keep .env: ENCRYPTION_KEY decrypts every credential AnythingMCP stores.
JWT_SECRET=
ENCRYPTION_KEY=

# First admin account, created by scripts/install.sh.
AMCP_ADMIN_EMAIL=
AMCP_ADMIN_PASSWORD=

# Amazon Seller Central (SP-API): fill these and re-run scripts/install.sh to install the connector.
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_ENDPOINT=
SPAPI_MARKETPLACE_ID=
SPAPI_SELLER_ID=

# Written by scripts/install.sh.
MCP_URL=
MCP_API_KEY=
